  companies            companies?                @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vacancies_company_id_foreign")
  contacts             contacts?                 @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vacancies_contact_id_foreign")
  vacancy_allowances   vacancy_allowances[]
  vacancy_languages    vacancy_languages[]
  vacancy_skills       vacancy_skills[]

  @@index([company_id], map: "vacancies_company_id_foreign")
  @@index([contact_id], map: "vacancies_contact_id_foreign")
}

model vacancy_allowances {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  vacancy_id BigInt    @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  vacancies  vacancies @relation(fields: [vacancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vacancy_allowances_vacancy_id_foreign")

  @@index([vacancy_id], map: "vacancy_allowances_vacancy_id_foreign")
}

model vacancy_languages {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  vacancy_id BigInt    @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  level      String?   @db.VarChar(255)
  mandatory  Boolean?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  vacancies  vacancies @relation(fields: [vacancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vacancy_languages_vacancy_id_foreign")

  @@index([vacancy_id], map: "vacancy_languages_vacancy_id_foreign")
}

model vacancy_skills {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  vacancy_id BigInt    @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  mandatory  Boolean?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  vacancies  vacancies @relation(fields: [vacancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vacancy_skills_vacancy_id_foreign")

  @@index([vacancy_id], map: "vacancy_skills_vacancy_id_foreign")
}

model vacation_requests {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id    BigInt    @db.UnsignedBigInt
  company_id     BigInt    @db.UnsignedBigInt
  start_date     DateTime? @db.Date
  end_date       DateTime? @db.Date
  number_of_days String?   @db.VarChar(255)
  status         String    @default("pending") @db.VarChar(255)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  companies      companies @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vacation_requests_company_id_foreign")
  employees      employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vacation_requests_employee_id_foreign")

  @@index([company_id], map: "vacation_requests_company_id_foreign")
  @@index([employee_id], map: "vacation_requests_employee_id_foreign")
}

enum vacancies_work_type {
  On_Site     @map("On-Site")
  Hybrid
  Home_Office @map("Home Office")
}

enum vacancies_contract_model {
  Indefinite_Period  @map("Indefinite Period")
  Temporary_Contract @map("Temporary Contract")
}

enum vacancies_status {
  Open
  In_Progress @map("In Progress")
  Waiting
  Cancelled
  Finalized
}
