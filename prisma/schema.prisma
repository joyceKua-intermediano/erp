generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model banking_details {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  document_id           BigInt    @db.UnsignedBigInt
  bank_name             String?   @db.VarChar(255)
  branch_name           String?   @db.VarChar(255)
  bank_code             String?   @db.VarChar(255)
  account_number        String?   @db.VarChar(255)
  account_type          String?   @db.VarChar(255)
  bank_account_currency String?   @db.VarChar(255)
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  documents             documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "banking_details_document_id_foreign")

  @@index([document_id], map: "banking_details_document_id_foreign")
}

model banks {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  country_id  BigInt        @db.UnsignedBigInt
  bank_name   String?       @db.VarChar(255)
  created_at  DateTime?     @db.Timestamp(0)
  updated_at  DateTime?     @db.Timestamp(0)
  deleted_at  DateTime?     @db.Timestamp(0)
  countries   countries     @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "banks_country_id_foreign")
  investments investments[]

  @@index([country_id], map: "banks_country_id_foreign")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model companies {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  user_id             BigInt?               @db.UnsignedBigInt
  name                String                @db.VarChar(255)
  website             String?               @db.VarChar(255)
  vat                 String?               @db.VarChar(255)
  tax_id              String?               @db.VarChar(255)
  country             String?               @db.VarChar(255)
  state               String?               @db.VarChar(255)
  city                String?               @db.VarChar(255)
  postal_code         String?               @db.VarChar(255)
  address             String?               @db.VarChar(255)
  industry_field_id   BigInt?               @db.UnsignedBigInt
  number_of_employees Int?
  is_customer         Boolean               @default(false)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  deleted_at          DateTime?             @db.Timestamp(0)
  users               users?                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "companies_user_id_foreign")
  industry_fields     industry_fields?      @relation(fields: [industry_field_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "companies_industry_field_id_foreign")
  contacts            contacts[]
  contracts           contracts[]
  customers           customers[]
  employee_expenses   employee_expenses[]
  invoice_details     invoice_details[]
  invoices            invoices[]
  leads               leads[]
  monthly_timesheets  monthly_timesheets[]
  msp_payroll_company msp_payroll_company[]
  quotations          quotations[]
  staff_trackers      staff_trackers[]
  vacancies           vacancies[]
  vacation_requests   vacation_requests[]

  @@index([industry_field_id], map: "companies_industry_field_id_foreign")
  @@index([user_id], map: "companies_user_id_foreign")
}

model consultants {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  country_id     BigInt           @db.UnsignedBigInt
  date_of_birth  DateTime?        @db.Date
  name           String           @unique(map: "consultants_name_unique") @db.VarChar(255)
  email          String?          @db.VarChar(255)
  mobile_number  String?          @db.VarChar(255)
  address        String?          @db.Text
  employer       String?          @map("employeer") @db.VarChar(255)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  deleted_at     DateTime?        @db.Timestamp(0)
  countries      countries        @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "consultants_country_id_foreign")
  employees      employees[]
  quotations     quotations[]
  staff_trackers staff_trackers[]

  @@index([country_id], map: "consultants_country_id_foreign")
}

model contacts {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt?     @db.UnsignedBigInt
  company_id      BigInt?     @db.UnsignedBigInt
  contact_name    String      @db.VarChar(255)
  surname         String?     @db.VarChar(255)
  email           String?     @db.VarChar(255)
  linkedin        String?     @db.VarChar(255)
  mobile          String?     @db.VarChar(255)
  phone           String?     @db.VarChar(255)
  position        String?     @db.VarChar(255)
  department      String?     @db.VarChar(255)
  is_main_contact Boolean     @default(false)
  created_at      DateTime?   @db.Timestamp(0)
  updated_at      DateTime?   @db.Timestamp(0)
  deleted_at      DateTime?   @db.Timestamp(0)
  companies       companies?  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contacts_company_id_foreign")
  users           users?      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "contacts_user_id_foreign")
  leads           leads[]
  vacancies       vacancies[]

  @@index([company_id], map: "contacts_company_id_foreign")
  @@index([user_id], map: "contacts_user_id_foreign")
}

model contracts {
  id                             BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  template_id                    BigInt?                          @db.UnsignedBigInt
  company_id                     BigInt?                          @db.UnsignedBigInt
  partner_id                     BigInt?                          @db.UnsignedBigInt
  intermediano_company_id        BigInt?                          @db.UnsignedBigInt
  employee_id                    BigInt                           @db.UnsignedBigInt
  quotation_id                   BigInt?                          @db.UnsignedBigInt
  country_id                     BigInt?                          @db.UnsignedBigInt
  country_work                   String?                          @db.VarChar(255)
  job_title                      String?                          @db.VarChar(255)
  translated_position            String?                          @db.VarChar(255)
  start_date                     DateTime?                        @db.Date
  end_date                       DateTime?                        @db.Date
  gross_salary                   String?                          @db.VarChar(255)
  contract_type                  String?                          @db.VarChar(255)
  contract_version               String?                          @db.VarChar(50)
  job_description                String?                          @db.Text
  translated_job_description     String?                          @db.Text
  is_sent_to_employee            Boolean?                         @default(false)
  signature                      String?                          @default("Pending Signature") @db.VarChar(255)
  signed_contract                DateTime?                        @db.DateTime(0)
  admin_signature                String?                          @default("Pending Signature") @db.VarChar(255)
  admin_signed_contract          DateTime?                        @db.DateTime(0)
  admin_signed_by                BigInt?                          @db.UnsignedBigInt
  is_integral                    Boolean?                         @default(false)
  deleted_at                     DateTime?                        @db.Timestamp(0)
  created_at                     DateTime?                        @db.Timestamp(0)
  updated_at                     DateTime?                        @db.Timestamp(0)
  users                          users?                           @relation(fields: [admin_signed_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_admin_signed_by_foreign")
  companies                      companies?                       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_company_id_foreign")
  countries                      countries?                       @relation(fields: [country_id], references: [id], onUpdate: NoAction, map: "contracts_country_id_foreign")
  employees                      employees                        @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_employee_id_foreign")
  templates                      templates?                       @relation(fields: [template_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contracts_ibfk_1")
  partners                       partners?                        @relation(fields: [partner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_partner_id_foreign")
  quotations                     quotations?                      @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_quotation_id_foreign")
  intermediano_companies         intermediano_companies?          @relation(fields: [intermediano_company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_intermediano_company")
  supplementary_contract_details supplementary_contract_details[]

  @@index([admin_signed_by], map: "contracts_admin_signed_by_foreign")
  @@index([company_id], map: "contracts_company_id_foreign")
  @@index([country_id], map: "contracts_country_id_foreign")
  @@index([employee_id], map: "contracts_employee_id_foreign")
  @@index([partner_id], map: "contracts_partner_id_foreign")
  @@index([quotation_id], map: "contracts_quotation_id_foreign")
  @@index([intermediano_company_id], map: "fk_intermediano_company")
  @@index([template_id], map: "template_id")
}

model countries {
  id                       BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  name                     String                   @unique(map: "countries_name_unique") @db.VarChar(255)
  income_tax_rate          Decimal?                 @db.Decimal(5, 2)
  use_real_time_conversion Boolean                  @default(false)
  created_at               DateTime?                @db.Timestamp(0)
  updated_at               DateTime?                @db.Timestamp(0)
  deleted_at               DateTime?                @db.Timestamp(0)
  banks                    banks[]
  consultants              consultants[]
  contracts                contracts[]
  country_annual_setups    country_annual_setups[]
  currencies               currencies[]
  holidays                 holidays[]
  intermediano_companies   intermediano_companies[]
  provinces                provinces[]
  quotations               quotations[]
  templates                templates[]
}

model country_annual_setups {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  country_id    BigInt    @db.UnsignedBigInt
  year          String    @db.VarChar(255)
  uvt_amount    Decimal?  @db.Decimal(15, 2)
  capped_amount Decimal?  @db.Decimal(15, 2)
  deleted_at    DateTime? @db.Timestamp(0)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  countries     countries @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "country_annual_setups_country_id_foreign")

  @@unique([country_id, year], map: "country_year_unique")
}

model currencies {
  id                       BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  country_id               BigInt        @db.UnsignedBigInt
  currency_name            String?       @db.VarChar(255)
  currency_quota           Decimal?      @db.Decimal(10, 2)
  created_at               DateTime?     @db.Timestamp(0)
  updated_at               DateTime?     @db.Timestamp(0)
  deleted_at               DateTime?     @db.Timestamp(0)
  converted_currency_quota Decimal?      @default(0.00) @db.Decimal(10, 2)
  countries                countries     @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "currencies_country_id_foreign")
  investments              investments[]

  @@index([country_id], map: "currencies_country_id_foreign")
}

model customers {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  company_id BigInt?    @db.UnsignedBigInt
  partner_id BigInt?    @db.UnsignedBigInt
  name       String     @db.VarChar(255)
  email      String     @unique(map: "customers_email_unique") @db.VarChar(255)
  password   String     @db.VarChar(255)
  deleted_at DateTime?  @db.Timestamp(0)
  created_at DateTime?  @db.Timestamp(0)
  updated_at DateTime?  @db.Timestamp(0)
  companies  companies? @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customers_company_id_foreign")
  partners   partners?  @relation(fields: [partner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_partner_id")

  @@index([company_id], map: "customers_company_id_foreign")
  @@index([partner_id], map: "fk_partner_id")
}

model dependents {
  id                      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  personal_information_id BigInt               @db.UnsignedBigInt
  full_name               String?              @db.VarChar(255)
  relationship            String?              @db.VarChar(255)
  date_of_birth           DateTime?            @db.Date
  tax_id                  String?              @db.VarChar(255)
  created_at              DateTime?            @db.Timestamp(0)
  updated_at              DateTime?            @db.Timestamp(0)
  personal_information    personal_information @relation(fields: [personal_information_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dependents_personal_information_id_foreign")

  @@index([personal_information_id], map: "dependents_personal_information_id_foreign")
}

model documents {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id           BigInt                  @db.UnsignedBigInt
  personal_id           String?                 @db.VarChar(255)
  organism              String?                 @db.VarChar(255)
  tax_id                String?                 @db.VarChar(255)
  expiration            DateTime?               @db.Date
  other                 String?                 @db.VarChar(255)
  is_driver_license     Boolean                 @default(false)
  has_insurance         Boolean                 @default(false)
  category              String?                 @db.VarChar(255)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  banking_details       banking_details[]
  employees             employees               @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "documents_employee_id_foreign")
  employee_files        employee_files[]
  social_security_infos social_security_infos[]

  @@index([employee_id], map: "documents_employee_id_foreign")
}

model emergency_contacts {
  id                      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  personal_information_id BigInt               @db.UnsignedBigInt
  emergency_contact_name  String?              @db.VarChar(255)
  relationship            String?              @db.VarChar(255)
  mobile_number           String?              @db.VarChar(255)
  email                   String?              @db.VarChar(255)
  created_at              DateTime?            @db.Timestamp(0)
  updated_at              DateTime?            @db.Timestamp(0)
  personal_information    personal_information @relation(fields: [personal_information_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "emergency_contacts_personal_information_id_foreign")

  @@index([personal_information_id], map: "emergency_contacts_personal_information_id_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employee_expenses {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id   BigInt    @db.UnsignedBigInt
  company_id    BigInt    @db.UnsignedBigInt
  expenses      String    @db.LongText
  status        String    @default("pending") @db.VarChar(255)
  type          String?   @db.VarChar(255)
  cost_center   String?   @db.VarChar(255)
  currency_name String?   @db.VarChar(255)
  created_by    String    @db.VarChar(255)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  companies     companies @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "employee_expenses_company_id_foreign")
  employees     employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_expenses_employee_id_foreign")

  @@index([company_id], map: "employee_expenses_company_id_foreign")
  @@index([employee_id], map: "employee_expenses_employee_id_foreign")
}

model employee_files {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  document_id        BigInt    @db.UnsignedBigInt
  document_type      String    @db.VarChar(255)
  file_path          String    @db.VarChar(255)
  original_file_name String    @db.VarChar(255)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  documents          documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_files_document_id_foreign")

  @@index([document_id], map: "employee_files_document_id_foreign")
}

model employees {
  id                      BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                    String                  @db.VarChar(255)
  consultant_id           BigInt?                 @db.UnsignedBigInt
  email                   String                  @unique(map: "employees_email_unique") @db.VarChar(255)
  password                String                  @db.VarChar(255)
  intermediano_company_id BigInt?                 @db.UnsignedBigInt
  deleted_at              DateTime?               @db.Timestamp(0)
  created_at              DateTime?               @db.Timestamp(0)
  updated_at              DateTime?               @db.Timestamp(0)
  contracts               contracts[]
  documents               documents[]
  employee_expenses       employee_expenses[]
  consultants             consultants?            @relation(fields: [consultant_id], references: [id], onUpdate: NoAction, map: "employees_consultant_id_foreign")
  intermediano_companies  intermediano_companies? @relation(fields: [intermediano_company_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "employees_intermediano_company_id_foreign")
  invoices                invoices[]
  monthly_timesheets      monthly_timesheets[]
  payslips                payslips[]
  personal_information    personal_information[]
  vacation_requests       vacation_requests[]

  @@index([consultant_id], map: "employees_consultant_id_foreign")
  @@index([intermediano_company_id], map: "employees_intermediano_company_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model holidays {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  country_id BigInt    @db.UnsignedBigInt
  year       Int       @db.Year
  holidays   String    @db.LongText
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  countries  countries @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "holidays_country_id_foreign")

  @@unique([country_id, year], map: "holidays_country_id_year_unique")
}

model industry_fields {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt?          @db.UnsignedBigInt
  name           String           @db.VarChar(255)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  deleted_at     DateTime?        @db.Timestamp(0)
  users          users?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "industry_fields_user_id_foreign")
  companies      companies[]
  staff_trackers staff_trackers[]

  @@index([user_id], map: "industry_fields_user_id_foreign")
}

model intermediano_companies {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name           String           @db.VarChar(255)
  contact_name   String           @db.VarChar(255)
  mobile_number  String           @db.VarChar(255)
  email          String           @db.VarChar(255)
  address        String           @db.VarChar(255)
  tax_id         String           @db.VarChar(255)
  country_id     BigInt           @db.UnsignedBigInt
  deleted_at     DateTime?        @db.Timestamp(0)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  contracts      contracts[]
  employees      employees[]
  invoices       invoices[]
  quotations     quotations[]
  countries      countries        @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "intermediano_companies_country_id_foreign")
  staff_trackers staff_trackers[]
  role_clusters  role_clusters[]
  templates      templates[]

  @@index([country_id], map: "intermediano_companies_country_id_foreign")
}

model investments {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  bank_id           BigInt     @db.UnsignedBigInt
  currency_id       BigInt     @db.UnsignedBigInt
  capital           Decimal    @db.Decimal(13, 2)
  rate_type         String     @db.VarChar(255)
  interest_rate     Decimal    @db.Decimal(10, 2)
  deposit_date      DateTime   @db.Date
  withdrawal_period Int        @db.SmallInt
  year              Int        @db.SmallInt
  created_at        DateTime?  @db.Timestamp(0)
  updated_at        DateTime?  @db.Timestamp(0)
  banks             banks      @relation(fields: [bank_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "investments_bank_id_foreign")
  currencies        currencies @relation(fields: [currency_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "investments_currency_id_foreign")

  @@index([bank_id], map: "investments_bank_id_foreign")
  @@index([currency_id], map: "investments_currency_id_foreign")
  @@index([year], map: "investments_year_index")
}

model invoice_details {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  company_id       BigInt    @db.UnsignedBigInt
  contact_person   String?   @db.VarChar(255)
  email            String?   @db.VarChar(255)
  mobile_number    String?   @db.VarChar(255)
  invoice_number   String?   @db.VarChar(255)
  invoice_cycle    String?   @db.VarChar(255)
  invoice_deadline String?   @db.VarChar(255)
  currency_payment String?   @db.VarChar(255)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  companies        companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoice_details_company_id_foreign")

  @@index([company_id], map: "invoice_details_company_id_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoices {
  id                      BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id             BigInt                 @db.UnsignedBigInt
  company_id              BigInt                 @db.UnsignedBigInt
  invoice_date            DateTime               @db.Date
  invoice_items           String                 @db.LongText
  intermediano_company_id BigInt                 @db.UnsignedBigInt
  deleted_at              DateTime?              @db.Timestamp(0)
  created_at              DateTime?              @db.Timestamp(0)
  updated_at              DateTime?              @db.Timestamp(0)
  companies               companies              @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoices_company_id_foreign")
  employees               employees              @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoices_employee_id_foreign")
  intermediano_companies  intermediano_companies @relation(fields: [intermediano_company_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "invoices_intermediano_company_id_foreign")

  @@index([company_id], map: "invoices_company_id_foreign")
  @@index([employee_id], map: "invoices_employee_id_foreign")
  @@index([intermediano_company_id], map: "invoices_intermediano_company_id_foreign")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
